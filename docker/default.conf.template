# Written to /etc/nginx/conf.d/default.conf by envsubst at startup.

# The bootstrap files have no hash in their name and must never get stuck in a cache.
# A single map instead of an add_header per location: an add_header in a location switches
# off all add_headers of the server block above it.
map $uri $cache_control {
    default                                                          "public, max-age=3600";
    ~^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json)?$  "no-cache";
}

# Somebody else's server is behind /api/: one address may not use this proxy to hammer it.
# The app itself stays far below this (a cold start is a dozen requests). Behind another
# reverse proxy every visitor arrives from that proxy's address and shares this allowance.
limit_req_zone $binary_remote_addr zone=api:10m rate=${API_RATE};

server {
    # Dual-stack: probes and Services may come in over IPv6.
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    # Relative redirects: the outside world does not know the internal port 8080.
    absolute_redirect off;
    client_max_body_size 5m;

    # Resolve hostnames again on each request instead of once at startup.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=60s;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # Cross-origin isolation: without these two the wasm renderer falls back to a single thread.
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy credentialless always;
    add_header Cache-Control $cache_control;
    # Only our own files, the proxies on this origin, and Google's font server (Flutter
    # fetches fallback fonts for characters Roboto lacks). 'wasm-unsafe-eval' is what
    # compiling WebAssembly is called; inline styles are how Flutter positions its canvas.
    # CSP_HEADER decides whether this is enforced or only reported in the browser console.
    add_header ${CSP_HEADER} "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        limit_req zone=api burst=${API_BURST} nodelay;
        # Not the default 503: the app takes that for "server unreachable" and goes offline.
        limit_req_status 429;
        set $sportivity ${SPORTIVITY_UPSTREAM};
        rewrite ^/api/(.*)$ /SportivityAppV3/$1 break;
        proxy_pass $sportivity;
        include /etc/nginx/conf.d/proxy-common.inc;
    }

    # Empty as long as NEXTCLOUD_UPSTREAM is not set; see 18-dav-proxy.sh.
    include /etc/nginx/conf.d/dav.inc;

    # The WebAssembly build starts from an ES module, main.dart.mjs. nginx's mime.types does
    # not know .mjs and would serve it as application/octet-stream, which a browser refuses
    # to run as a module (the more so with nosniff): the app would stay on its loading text
    # in every browser that takes the WebAssembly path.
    location ~ \.mjs$ {
        types { }
        default_type application/javascript;
    }

    location / {
        # SPA: unknown paths are routes of the app.
        try_files $uri $uri/ /index.html;
    }
}
